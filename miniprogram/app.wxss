/* app.wxss —— 全局样式 */
page {
  /* 主色：克制的蓝，不用渐变 */
  --brand: #2E6BE6;
  --brand-soft: #EDF3FF;

  /* 中性色 */
  --ink: #1F2329;
  --ink-2: #646A73;
  --ink-3: #A7ACB4;
  --bg: #F7F8FA;
  --card: #FFFFFF;
  --line: #EEF0F3;

  /* 价格强调 */
  --accent: #F5533D;

  --radius: 16rpx;
  --radius-sm: 12rpx;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 28rpx;
}

/* 主按钮：实色，轻投影 */
.btn-primary {
  background: var(--brand);
  color: #fff;
  border-radius: 14rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 92rpx;
  height: 92rpx;
  text-align: center;
  transition: opacity .12s ease;
}
.btn-primary::after { border: none; }
.btn-primary:active { opacity: .88; }
.btn-primary--disabled { opacity: .5; }

/* 次按钮 */
.btn-ghost {
  background: #fff;
  color: var(--ink);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 32rpx;
  line-height: 90rpx;
  text-align: center;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 32rpx;
}
