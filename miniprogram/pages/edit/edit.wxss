/* pages/edit/edit.wxss */
.page {
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
  box-sizing: border-box;
}

/* 预览 */
.preview-wrap {
  padding: 40rpx 0 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.preview-box {
  width: 420rpx;
  height: 560rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.preview-img { width: 100%; height: 100%; }
.preview-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.preview-empty-text {
  font-size: 26rpx;
  color: var(--ink-3);
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid var(--line);
  border-top-color: var(--brand);
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin .8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.preview-caption {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

/* 面板 */
.panel {
  margin-top: 24rpx;
  padding: 32rpx;
  background: var(--card);
  border-radius: var(--radius);
}
.panel-title {
  font-size: 28rpx;
  color: var(--ink-2);
  margin-bottom: 28rpx;
}

/* 底色 */
.color-row { display: flex; gap: 40rpx; }
.color-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.color-dot {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  margin-bottom: 14rpx;
}
.color-item--active .color-dot {
  border: 4rpx solid var(--brand);
}
.color-name {
  font-size: 26rpx;
  color: var(--ink-2);
}
.color-item--active .color-name { color: var(--brand); }

/* 精修强度 */
.level-row { display: flex; gap: 20rpx; }
.level-item {
  flex: 1;
  padding: 24rpx 16rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--line);
  text-align: center;
}
.level-item--active {
  border-color: var(--brand);
  background: var(--brand-soft);
}
.level-name {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}
.level-item--active .level-name { color: var(--brand); }
.level-desc {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}
.level-note {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

/* 底部 */
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
}
