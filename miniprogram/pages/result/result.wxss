/* pages/result/result.wxss */
.page {
  min-height: 100vh;
  padding: 0 32rpx 200rpx;
  box-sizing: border-box;
}

.result-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 8rpx;
}
.result-box {
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  overflow: hidden;
}
.result-img {
  width: 420rpx;
  height: 560rpx;
  background: #f2f4f9;
  display: block;
}
.watermark-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.status-message {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  color: var(--ink-2);
  background: var(--brand-soft);
  border-radius: 10rpx;
  font-size: 24rpx;
  text-align: center;
}
.result-caption {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

/* 详情 */
.detail-card {
  margin-top: 32rpx;
  background: var(--card);
  border-radius: var(--radius);
  padding: 0 32rpx;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.detail-row:last-child { border-bottom: none; }
.detail-label { font-size: 28rpx; color: var(--ink-3); }
.detail-value { font-size: 28rpx; color: var(--ink); }

/* 底部支付栏 */
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: var(--card);
  border-top: 1rpx solid var(--line);
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.price-line {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.price-symbol { font-size: 30rpx; color: var(--accent); font-weight: 600; }
.price-num { font-size: 52rpx; color: var(--accent); font-weight: 600; margin-right: 16rpx; }
.price-tip { font-size: 24rpx; color: var(--ink-3); }
.footer-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  text-align: center;
}
.save-sheet { margin-top: 16rpx; }
