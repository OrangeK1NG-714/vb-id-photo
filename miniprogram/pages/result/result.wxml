<!--pages/result/result.wxml-->
<view class="page">
  <view class="result-wrap">
    <view class="result-box">
      <image class="result-img" src="{{previewSrc}}" mode="aspectFit" />
    </view>
    <view wx:if="{{!paid}}" class="watermark-hint">预览带水印，付费后可下载无水印高清图</view>
    <view wx:if="{{statusMessage}}" class="status-message">{{statusMessage}}</view>
    <view class="result-caption">{{sizeName}} · {{sizeSpec}} · {{colorName}}</view>
  </view>

  <view class="detail-card">
    <view class="detail-row">
      <text class="detail-label">规格</text>
      <text class="detail-value">{{sizeName}}（{{sizeSpec}}）</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">底色</text>
      <text class="detail-value">{{colorName}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">输出</text>
      <text class="detail-value">300dpi 高清 · 含冲印排版图</text>
    </view>
  </view>

  <view class="footer">
    <block wx:if="{{status === 'expired'}}">
      <button class="btn-primary" bindtap="onRemake">重新制作</button>
    </block>
    <block wx:elif="{{!paid}}">
      <view class="price-line">
        <text class="price-symbol">¥</text>
        <text class="price-num">{{price}}</text>
        <text class="price-tip">无水印高清 + 六寸排版图</text>
      </view>
      <button wx:if="{{status !== 'paying'}}" class="btn-primary {{paying ? 'btn-primary--disabled' : ''}}" bindtap="onPay" disabled="{{paying}}">
        {{paying ? '支付中…' : '支付并下载'}}
      </button>
      <button wx:else class="btn-primary" bindtap="onRefresh" disabled="{{recovering}}">
        {{recovering ? '查询中…' : '刷新支付结果'}}
      </button>
    </block>
    <block wx:else>
      <button class="btn-primary" bindtap="onSave">保存高清证件照</button>
      <button class="btn-ghost save-sheet" bindtap="onSaveSheet">保存六寸排版图</button>
      <view class="footer-hint">已支付，可重复保存</view>
    </block>
  </view>
</view>
