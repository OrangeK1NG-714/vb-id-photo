# 开发环境。生产必须改为 production，并保持 ALLOW_MOCK_PAYMENTS=false。
NODE_ENV=development
ALLOW_MOCK_PAYMENTS=true

PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=./data
STORAGE_DIR=./storage
FILE_RETENTION_MINUTES=120
CLEANUP_INTERVAL_MINUTES=15
MAX_FILE_MB=10
MAX_IMAGE_PIXELS=20000000
DOWNLOAD_SECRET=development-only-change-to-a-random-32-byte-secret

# 应用层抗滥用。生产反向代理为紧邻的一层时 TRUST_PROXY_HOPS=1；源站必须由防火墙限制回源。
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_PER_MINUTE=240
PROCESS_RATE_LIMIT_PER_10_MINUTES=12
PREVIEW_RATE_LIMIT_PER_MINUTE=120
DOWNLOAD_RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_PROCESSING=2
REQUEST_TIMEOUT_MS=60000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
MAX_REQUESTS_PER_SOCKET=100
MAX_CONNECTIONS=200
SHUTDOWN_GRACE_MS=10000

# 微信小程序
WX_APPID=
WX_SECRET=

# 微信支付 V3。生产环境全部必填，私钥和平台证书不得提交 Git。
WX_MCH_ID=
WX_PAY_KEY=
WX_PAY_SERIAL=
WX_PAY_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
WX_PAY_PLATFORM_CERT_PATH=./cert/wechatpay_platform.pem
WX_PAY_NOTIFY_URL=
PRICE_FEN=600

# 人像分割。生产环境必填；未配置时仅允许开发降级，不具备可售质量。
SEG_API_URL=
SEG_API_KEY=

# 可选人脸检测。未配置时明确使用 attention 裁切降级，不宣称头部位置已校验。
FACE_API_URL=
FACE_API_KEY=
